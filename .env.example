# Wedding Website Environment Variables
# Copy this file to .env and fill in your actual values

# Site Configuration
VITE_SITE_URL=https://alfinamugni.wedding

# Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Database (Airtable)
VITE_AIRTABLE_API_KEY=your_airtable_api_key_here
VITE_AIRTABLE_BASE_ID=your_airtable_base_id_here

# Email Service (EmailJS)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_RSVP_TEMPLATE=your_rsvp_template_id
VITE_EMAILJS_CONTACT_TEMPLATE=your_contact_template_id
VITE_EMAILJS_REMINDER_TEMPLATE=your_reminder_template_id

# Contact Information
VITE_CONTACT_EMAIL=hello@alfinamugni.wedding

# CDN Configuration
VITE_CDN_BASE_URL=https://your-cdn-url.com

# Monitoring & Error Tracking
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_ALERT_EMAIL=admin@alfinamugni.wedding
VITE_ALERT_WEBHOOK=your_alert_webhook_url

# Logging
VITE_LOGGING_ENDPOINT=your_logging_endpoint
VITE_LOGGING_API_KEY=your_logging_api_key

# Deployment
NETLIFY_BUILD_HOOK=your_netlify_build_hook
NETLIFY_EMERGENCY_HOOK=your_netlify_emergency_hook