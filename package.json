{
  "name": "alfinamugni-wedding",
  "description": "Alfina & Mugni Wedding Website - Modern wedding invitation and management system",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "./scripts/deploy-production.sh",
    "deploy:preview": "wrangler pages deploy dist --project-name alfinamugni-wedding-preview",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:production": "node scripts/test-production.js",
    "db:migrate": "wrangler d1 migrations apply wedding-database --remote",
    "db:migrate:local": "wrangler d1 migrations apply wedding-database --local",
    "db:backup": "wrangler d1 export wedding-database --remote --output backup-$(date +%Y%m%d-%H%M%S).sql",
    "admin:setup": "node scripts/setup-admin.js"
  },
  "devDependencies": {
    "@auth/qwik": "^0.8.0",
    "@builder.io/qwik": "^1.14.1",
    "@builder.io/qwik-city": "^1.14.1",
    "@eslint/js": "latest",
    "@modular-forms/qwik": "^0.29.1",
    "@qwikdev/pwa": "^0.0.4",
    "@qwikest/icons": "^0.0.13",
    "@tailwindcss/postcss": "4.0.0-alpha.30",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "9.25.1",
    "eslint-plugin-qwik": "^1.14.1",
    "globals": "16.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "5.4.5",
    "typescript-eslint": "8.26.1",
    "undici": "*",
    "vite": "5.3.5",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@cloudflare/workers-types": "^4.20250921.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.542.0",
    "motion": "^12.23.11",
    "resend": "^6.1.0",
    "sharp": "^0.34.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "wrangler": "^4.38.0",
    "zod": "^4.1.5"
  }
}
